{
  "manifest_version": 3,
  "name": "browser-mcp",
  "version": "1.0.0",
  "description": "Browser automation bridge for ZCode / Claude Code via MCP",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "storage",
    "tabGroups",
    "alarms",
    "windows"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [],
  "action": {
    "default_popup": "popup.html",
    "default_title": "browser-mcp"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
